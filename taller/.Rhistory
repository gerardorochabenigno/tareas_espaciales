resultados_finales_pol <- read.csv("data/resultados_finales_poligonos.csv") |>
mutate(
CVE_ENT = str_pad(as.character(CVE_ENT), width = 2, pad = "0", side = "left")
)
# Calculamos métricas
df_metricas <- resultados_finales_pol |>
left_join(df_centros, by="CVE_ENT") |>
select(-c(lat, lon)) |>
mutate(
Poblacion = POBTOT_tot / max_viviendas_tot,
Sanitario = VPH_C_ELEC_tot / max_viviendas_tot,
Drenaje = VPH_C_ELEC_tot / max_viviendas_tot,
Refrigerador = VPH_DRENAJ_tot  / max_viviendas_tot,
Automovil = VPH_AUTOM_tot / max_viviendas_tot,
Televisor = VPH_TV_tot / max_viviendas_tot,
Computadora = VPH_PC_tot  / max_viviendas_tot,
Celular = VPH_CEL_tot / max_viviendas_tot,
Internet = VPH_INTER_tot / max_viviendas_tot,
TV_paga = VPH_STVP_tot / max_viviendas_tot,
Videojuegos = VPH_CVJ_tot / max_viviendas_tot,
) |>
select(Estado, Poblacion, Sanitario, Drenaje, Refrigerador, Automovil, Televisor, Computadora, Celular, Internet, TV_paga, Videojuegos)
# Preparamos los datos (removemos estado porque no es una variable informativa)
A <- df_metricas |> select(-Estado)
# Matriz para almacenar los resultados
mat <- matrix(0, 6, 2) %>% data.frame()
colnames(mat) <- c("cluster", "withinss")
# Loop para probar distintos números de clusters
for (i in 1:6) {
model <- kmeans(A, centers = i)
mat$cluster[i] <- i
mat$withinss[i] <- model$tot.withinss
}
model_4=kmeans(A,4)
# Gráfica de codo
plot(mat$withinss, type = "b", xlab = "Número de clusters", ylab = "Within", main="Gráfica 3. Método de codo para determinar clusters (segundo método)", ylim = c(0, 65))
View(resultados_finales_pol)
