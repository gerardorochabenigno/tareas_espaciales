file_estados <- "data/mg_2020_integrado/conjunto_de_datos/00ent.shp"
df_estados <- st_read(file_estados, quiet = TRUE) |>
select(CVE_ENT, geometry)
df_mapa <- resultados_finales |>
left_join(df_centros, by = "CVE_ENT") |>
select(-c(lat, lon, X)) |>
mutate(cluster = model_4$cluster)
df_mapa <- df_estados |>
left_join(df_mapa, by = "CVE_ENT") |>
select(geometry, cluster)
df_mapa <- st_transform(df_mapa, crs = 4326)
# Creamos paleta de colores
pal <- colorFactor(palette = c("red", "blue", "green", "yellow"),
domain = df_mapa$cluster)
# Crear mapa
mapa <-leaflet(df_mapa, options = leafletOptions(minZoom = 4, maxZoom = 8)) |>
addProviderTiles(providers$CartoDB.PositronNoLabels) |>
fitBounds(lng1 = -117.12776, lat1 = 14.5388286402,
lng2 = -86.811982388, lat2 = 32.72083) |>
setMaxBounds(lng1 = -117.12776, lat1 = 14.5388286402,
lng2 = -86.811982388, lat2 = 32.72083) |>
addPolygons(
fillColor = ~pal(cluster),
fillOpacity = 0.7,
color = "black",
weight = 1.5,
label = ~paste0("Cluster: ", cluster),
highlightOptions = highlightOptions(
weight = 3,
color = "#666",
fillOpacity = 0.9,
bringToFront = TRUE
)
) |>
addLegend(
position = "topright",
pal = pal,
values = ~cluster,
title = "Cluster",
opacity = 0.7
)
mapshot(mapa, file = "data/mapa_clusters.png")
